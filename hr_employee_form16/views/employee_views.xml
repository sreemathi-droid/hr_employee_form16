    <record id="hr_form16_tree_view" model="ir.ui.view">
        <field name="name">hr.form16.tree</field>
        <field name="model">hr.form16</field>
        <field name="arch" type="xml">
            <tree string="Form 16 List">
                <field name="employee_id"/>
                <field name="certificate_number"/>
                <field name="assessment_year"/>
                <field name="period_from"/>
                <field name="period_to"/>
            </tree>
        </field>
    </record>

    <record id="action_hr_form16" model="ir.actions.act_window">
            <field name="name">FORM16</field>
            <field name="res_model">hr.form16</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_id" ref="hr_employee_form16_only_view"/> -->
    </record>

        <!-- FORM16 Menu -->
    <record id="menu_hr_form16" model="ir.ui.menu">
            <field name="name">FORM16</field>
            <field name="parent_id" ref="hr.menu_hr_employee_payroll"/>
            <field name="action" ref="action_hr_form16"/>
            <field name="sequence">20</field>
    </record>

</odoo>
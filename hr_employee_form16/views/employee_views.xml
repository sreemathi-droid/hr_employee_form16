<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form16_only_view" model="ir.ui.view">
            <field name="name">form.form16.only.form</field>
            <field name="model">hr.form16</field>
            <field name="arch" type="xml">
                <form string="Form 16">

                        <header>
                            <button name="action_send_form16_email"
                                    string="Send Email"
                                    type="object"
                                    class="btn-primary"
                                    icon="fa-envelope"/>
                            <button name="action_generate_form16_pdf"
                                string="Generate Form16"
                                type="object"
                                class="btn-secondary"
                                icon="fa-print"/>
                        </header>
                    <sheet>
                        <group>
                            <group string="Basic Information">
                                <field name="employee_id"/>
                                <field name="period_from"/>
                                <field name="period_to"/>
                                <field name="assessment_year"/>
                                <field name="certificate_number"/>
                                <field name="pan_number"/>
                            </group>

                            <group string="Authorized Signatory">
                                <field name="authorized_signatory_name"/>
                                <field name="authorized_signatory_father_name"/>
                                <field name="authorized_signatory_designation"/>
                            </group>
                        </group>
                        <separator string="Quarterly TDS Details"/>
                        <group>
                            <group string="Quarter 1">
                                <field name="q1_receipt_number"/>
                                <field name="q1_amount_paid"/>
                                <field name="q1_tax_deducted"/>
                                <field name="q1_tax_deposited"/>
                            </group>
                            <group string="Quarter 2">
                                <field name="q2_receipt_number"/>
                                <field name="q2_amount_paid"/>
                                <field name="q2_tax_deducted"/>
                                <field name="q2_tax_deposited"/>
                            </group>
                        </group>
                        <group>
                            <group string="Quarter 3">
                                <field name="q3_receipt_number"/>
                                <field name="q3_amount_paid"/>
                                <field name="q3_tax_deducted"/>
                                <field name="q3_tax_deposited"/>
                            </group>
                            <group string="Quarter 4">
                                <field name="q4_receipt_number"/>
                                <field name="q4_amount_paid"/>
                                <field name="q4_tax_deducted"/>
                                <field name="q4_tax_deposited"/>
                            </group>
                        </group>
                        <group>
                            <group string="Totals">
                                <field name="total_amount_paid" readonly="1"/>
                                <field name="total_tax_deducted" readonly="1"/>
                                <field name="total_tax_deposited" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Salary Details (Part B)"/>
                        <group>
                            <group string="Gross Salary Components">
                                <field name="salary_sec_17_1"/>
                                <field name="perquisites_sec_17_2"/>
                                <field name="profits_sec_17_3"/>
                                <field name="gross_salary_total" readonly="1"/>
                                <field name="other_employer_salary"/>
                            </group>
                            <group string="Deductions">
                                <field name="exempt_allowances"/>
                                <field name="balance_after_exemptions" readonly="1"/>
                                <field name="standard_deduction"/>
                                <field name="total_deductions" readonly="1"/>
                                <field name="income_chargeable_salary" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Income Calculation">
                                <field name="other_income"/>
                                <field name="gross_total_income" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Chapter VI-A Deductions"/>
                        <group>
                            <group string="Section 80C Series">
                                <field name="epf_employee"/>
                                <field name="sec_80c_total" readonly="1"/>
                                <field name="sec_80ccc"/>
                                <field name="sec_80ccd"/>
                                <field name="sec_80ccd_1b"/>
                                <field name="sec_80ccd_2"/>
                                <field name="sec_80ccg"/>
                            </group>
                            <group string="Other Sections">
                                <field name="sec_80d"/>
                                <field name="sec_80e"/>
                                <field name="sec_80g"/>
                                <field name="sec_80tta"/>
                                <field name="other_sec_deductions"/>
                                <field name="total_chapter_via_deductions" readonly="1"/>
                            </group>
                        </group>

                        <separator string="Tax Calculation"/>
                        <group>
                            <group string="Tax Details">
                                <field name="total_taxable_income" readonly="1"/>
                                <field name="tax_on_total_income" readonly="1"/>
                                <field name="credit_87a"/>
                                <field name="surcharge"/>
                                <field name="health_education_cess" readonly="1"/>
                            </group>
                            <group string="Final Tax">
                                <field name="tax_payable" readonly="1"/>
                                <field name="relief_sec_89"/>
                                <field name="final_tax_payable" readonly="1"/>
                                <!-- <field name="seal_signature_filename" invisible="1"/> -->
                                <!-- <field name="seal_signature" widget="image" 
                                    options="{'size': [200, 120]}"/> -->
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
    </record>

